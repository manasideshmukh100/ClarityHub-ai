# ClarityHub AI Environment Variables

# App Settings
PROJECT_NAME="ClarityHub AI"
SECRET_KEY="clarityhub-secret-key-change-in-production-2026"

# Database (Postgres with pgvector in prod, SQLite in local dev)
DATABASE_URL="sqlite:///./clarityhub.db"

# LLM Provider Adapter ("gemini", "openai", "anthropic", or "mock")
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Uploads directory
UPLOAD_DIR="./uploads"

# Frontend URL
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
